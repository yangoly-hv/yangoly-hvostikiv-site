# Public site and Sanity read configuration
NEXT_PUBLIC_SITE_URL=https://example.org
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-05-15
# Server-only content token. Required to update the public top-donators list after approved payments.
SANITY_API_TOKEN=

# Private Sanity dataset used only by server-side payment routes.
SANITY_PAYMENTS_DATASET=payments
SANITY_PAYMENTS_TOKEN=
# Generate with: openssl rand -base64 32
PAYMENTS_ENCRYPTION_KEY=
# Required by the scheduled cleanup endpoint. Vercel sends this as a Bearer token.
CRON_SECRET=

# WayForPay payment gateway
WAYFORPAY_ACCOUNT=
WAYFORPAY_SECRET=
WAYFORPAY_DOMAIN=example.org
NEXT_PUBLIC_BASE_URL=https://example.org

# Monobank: one-time donate buttons use siteSettings.monobankJarUrl
# (public send.monobank.ua/jar/… link). The home collection block uses
# collection.monobankLongJarId for balance/goal. No Monobank token is required.

# Signed Sanity webhook and emergency full-revalidation endpoint
SANITY_REVALIDATE_SECRET=
SANITY_API_READ_TOKEN=
DRAFT_PREVIEW_SECRET=
REVALIDATE_OPS_SECRET=
REVALIDATE_SITE_URL=https://example.org

# Contact form and internal notifications about approved donations
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# Event registration → Google Sheets (share the spreadsheet with the service account)
# Enable Google Sheets API, create a service account, download JSON key.
GOOGLE_SHEETS_CLIENT_EMAIL=
# Paste the private_key value; keep \n escapes or use real newlines in .env.local
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional; default Реєстрації!A:I — app renames/creates the tab and Ukrainian headers if needed
# Header row: Дата подання | ID події | Мова | ПІБ | Email | Телефон | Тип хвостика | Ім'я хвостика | Коментар
GOOGLE_SHEETS_RANGE=Реєстрації!A:I
